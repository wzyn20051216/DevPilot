# Docker Compose 映射给 DevPilot 的宿主机工作区。
# 容器内仓库路径会对应到 /workspace/<project>。
DEVPILOT_HOST_WORKSPACE_ROOT=E:/desktop

# 任务队列与 Sandbox Worker 分离（技术手册 10.2.5）
# inline 进程内线程执行；sqlite/redis 由独立 Worker 进程领取执行
TASK_QUEUE_BACKEND=inline
# task_queue_backend=redis 时的连接地址
REDIS_URL=
# Worker 领取任务后的租约时长（秒），崩溃后超过该时长任务自动重投
TASK_WORKER_LEASE_SECONDS=300
# Worker 心跳续租间隔（秒），必须显著小于租约时长
TASK_WORKER_HEARTBEAT_SECONDS=30
# Worker 轮询队列的间隔（秒）
TASK_WORKER_POLL_SECONDS=1.0
# 任务最大尝试次数，超过后进入死信（dead）
TASK_MAX_ATTEMPTS=3
