# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM (OpenAI-compatible provider)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-api-endpoint/v1
LLM_MODEL=your_model_name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 单个 Agent 的累计 Token 上限；0 表示不限制
AGENT_TOKEN_BUDGET=0
# 单次工具观测进入下一轮上下文前保留的最大字符数
TOOL_OBSERVATION_MAX_CHARS=10000
# 完整保留最近消息，其余历史压缩为结构化摘要
AGENT_RECENT_MESSAGES=12
AGENT_HISTORY_SUMMARY_MAX_CHARS=6000
# 用于评测成本估算，单位为每百万 Token；不影响模型调用
LLM_PROMPT_COST_PER_MILLION=0
LLM_COMPLETION_COST_PER_MILLION=0
MCP_TIMEOUT_SECONDS=30

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token

# Storage and sandbox
# DATABASE_PATH=E:/desktop/DevPilot/backend/data/devpilot.db
SANDBOX_IMAGE=devpilot-sandbox:py312
WORKSPACE_ROOT=/workspace
# HOST_WORKSPACE_ROOT=E:/desktop

# Browser origins allowed to call FastAPI directly in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
