# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM (OpenAI-compatible provider)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-api-endpoint/v1
LLM_MODEL=your_model_name
# DeepSeek 可选：low / high / max；留空保持服务端默认
# LLM_REASONING_EFFORT=max
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 单个 Agent 的累计 Token 上限；0 表示不限制
AGENT_TOKEN_BUDGET=0
# 单次工具观测进入下一轮上下文前保留的最大字符数
TOOL_OBSERVATION_MAX_CHARS=10000
# 完整保留最近消息，其余历史压缩为结构化摘要
AGENT_RECENT_MESSAGES=12
AGENT_HISTORY_SUMMARY_MAX_CHARS=6000
# 用于评测成本估算，单位为每百万 Token；不影响模型调用
LLM_PROMPT_COST_PER_MILLION=0
LLM_COMPLETION_COST_PER_MILLION=0
MCP_TIMEOUT_SECONDS=30

# 动态 Agent 策略路由：按仓库规模、目标文件和问题语义选择结构导航/强制探针
STRATEGY_ROUTER_ENABLED=true
STRATEGY_OUTLINE_MIN_LINES=800
STRATEGY_OUTLINE_MIN_REPO_FILES=400
STRATEGY_PYTHON_MIN_RATIO=0.5

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token

# Storage and sandbox
# DATABASE_PATH=E:/desktop/DevPilot/backend/data/devpilot.db
SANDBOX_IMAGE=devpilot-sandbox:py312
WORKSPACE_ROOT=/workspace
# HOST_WORKSPACE_ROOT=E:/desktop

# 任务队列与 Sandbox Worker 分离（技术手册 10.2.5）
# inline 进程内线程执行；sqlite/redis 由独立 Worker 进程领取执行
TASK_QUEUE_BACKEND=inline
# task_queue_backend=redis 时的连接地址
REDIS_URL=
# Worker 领取任务后的租约时长（秒），过期后隔离为 dead，确认旧执行者停止后显式恢复
TASK_WORKER_LEASE_SECONDS=300
# Worker 心跳续租间隔（秒），必须显著小于租约时长
TASK_WORKER_HEARTBEAT_SECONDS=30
# Worker 轮询队列的间隔（秒）
TASK_WORKER_POLL_SECONDS=1.0
# 任务最大尝试次数，超过后进入死信（dead）
TASK_MAX_ATTEMPTS=3

# Browser origins allowed to call FastAPI directly in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# 存储后端：SQLite 为默认；跨机状态需 MySQL 8.0+（uv sync --extra mysql）
DATABASE_BACKEND=sqlite
MYSQL_URL=
MYSQL_POOL_SIZE=8

# 入队积压上限；0 不限制。在途任务的有限失败重试不受入队上限拒绝。
TASK_QUEUE_MAX_DEPTH=100
# 单 Worker 的并发上限；inline 上限按单 API 进程计。
TASK_WORKER_MAX_CONCURRENCY=2
TASK_INLINE_MAX_RUNNING=8

# API Key，逗号分隔。development/test 为空时兼容本地访问；production 必填。
API_KEYS=
# 仓库根目录白名单，逗号分隔。Windows 示例 E:/desktop，容器填写 /workspace。
ALLOWED_REPO_ROOTS=
